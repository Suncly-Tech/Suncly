# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Packaging and build output
build/
dist/
wheels/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files: may contain secrets, never commit them
.env
.env.*
!.env.example

# Test, coverage, lint and type-check caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# Private keys and certificates: never commit them
*.pem
*.key

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
