{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "suncly.vercel.app" }], "destination": "https://www.suncly.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "suncly.com" }], "destination": "https://www.suncly.com/:path*", "permanent": true }
  ]
}
