# Environment variables Suncly reads. Copy to .env and fill in; never commit .env.
# Every variable is optional. Settings are resolved in this order: built-in
# defaults, then the config file (SUNCLY_HOME/config.toml), then these variables.
# A blank value is the same as an unset one.

# Where Suncly keeps its state: file store, transcripts, deployment keys.
# Default: ~/.suncly
SUNCLY_HOME=

# Evidence store. When DATABASE_URL is set, the Postgres store is used; otherwise
# the file store under SUNCLY_HOME/store. Example (placeholder, not a real server):
# postgresql://suncly:change-me@localhost:5432/suncly
DATABASE_URL=

# Folder that receives one report folder per attestation. Default: ./suncly-reports
SUNCLY_REPORTS_DIR=

# Defaults for `suncly attest`; both are shown before anything runs.
# Repetitions per test case (default 5) and budget in attempts (default 2 x planned runs).
SUNCLY_RUNS=
SUNCLY_BUDGET_LIMIT=

# Runner limits: per-run timeout in seconds (default 30), latency limit written into
# drafted criteria in milliseconds (default 10000), retries per run (default 2),
# concurrent runs (default 4), seconds between GetTask polls (default 0.5).
SUNCLY_RUN_TIMEOUT_S=
SUNCLY_LATENCY_LIMIT_MS=
SUNCLY_MAX_RETRIES=
SUNCLY_CONCURRENCY=
SUNCLY_POLL_INTERVAL_S=

# Card fetching: timeout in seconds (default 10) and size limit in bytes (default 1000000).
SUNCLY_CARD_TIMEOUT_S=
SUNCLY_CARD_MAX_BYTES=

# Drafting: test cases per skill, one per declared example up to this cap (default 3).
SUNCLY_MAX_TEST_CASES_PER_SKILL=

# Credential for the agent under test. Read ONLY by the Runner process (DR-003).
# The full value of the HTTP Authorization header, for example "Bearer <token>".
# Placeholder only; never put a real token in a committed file.
SUNCLY_AGENT_AUTHORIZATION=

# ---------------------------------------------------------------------------------------
# Hosted product (API, worker, dispatcher). Every variable below is read by the hosted
# processes only; the CLI ignores them. See deploy/README.md and docs/API.md.

# development | test | staging | production. Production refuses local authentication,
# requires the OIDC settings and refuses SUNCLY_NETWORK_MODE=local.
SUNCLY_ENVIRONMENT=
# public (default: https on 443/8443 to public addresses only) | private_network | local
SUNCLY_NETWORK_MODE=
SUNCLY_PUBLIC_BASE_URL=
# Comma-separated origins allowed by CORS (the workspace).
SUNCLY_CORS_ORIGINS=
# The issuer name bound into every signed attestation (default suncly-local).
SUNCLY_ISSUER=
SUNCLY_ATTESTATION_VALIDITY_DAYS=

# Identity: an OpenID Connect provider (issuer URL, the audience the token must carry,
# the provider's JWKS endpoint)...
SUNCLY_OIDC_ISSUER=
SUNCLY_OIDC_AUDIENCE=
SUNCLY_OIDC_JWKS_URL=
# ...or, outside production only, local HS256 tokens (`suncly auth local-token`).
SUNCLY_LOCAL_AUTH_ENABLED=
SUNCLY_LOCAL_AUTH_SECRET=

# Judge model (Layer 2). Unset: model-judged criteria stay inconclusive. Usage is paid.
SUNCLY_MODEL_PROVIDER=
SUNCLY_MODEL=
SUNCLY_MODEL_MAX_OUTPUT_TOKENS=
SUNCLY_MODEL_EFFORT=
SUNCLY_MODEL_TIMEOUT_S=
ANTHROPIC_API_KEY=

# Billing: fake (default) or stripe. The Stripe adapter refuses live keys unless
# SUNCLY_STRIPE_ALLOW_LIVE_KEYS=1 is set deliberately.
SUNCLY_BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_TEAM=
SUNCLY_STRIPE_ALLOW_LIVE_KEYS=
SUNCLY_CHECKOUT_SUCCESS_URL=
SUNCLY_CHECKOUT_CANCEL_URL=
SUNCLY_PORTAL_RETURN_URL=
SUNCLY_PRICE_TABLE_VERSION=

# Worker: lease and heartbeat seconds, poll interval, attempts per job, external tool deadline.
SUNCLY_WORKER_LEASE_S=
SUNCLY_WORKER_HEARTBEAT_S=
SUNCLY_WORKER_POLL_S=
SUNCLY_JOB_MAX_ATTEMPTS=
SUNCLY_EXTERNAL_TOOL_TIMEOUT_S=

# Evidence in Cloud Storage instead of the local disk; Secret Manager project for agent
# credentials; the signing key (PEM, filled by the platform) or the secret holding it.
SUNCLY_EVIDENCE_BUCKET=
SUNCLY_SECRET_MANAGER_PROJECT=
SUNCLY_SIGNING_KEY=
SUNCLY_SIGNING_KEY_SECRET=

# External tools (worker only): the pinned A2A TCK checkout and an approved Promptfoo pack.
SUNCLY_A2A_TCK_DIR=
SUNCLY_PROMPTFOO_PACK=
SUNCLY_PROMPTFOO_BIN=
