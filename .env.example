# Environment variables Suncly reads. Copy to .env and fill in; never commit .env.
# Every variable is optional. Settings are resolved in this order: built-in
# defaults, then the config file (SUNCLY_HOME/config.toml), then these variables.
# A blank value is the same as an unset one.

# Where Suncly keeps its state: file store, transcripts, deployment keys.
# Default: ~/.suncly
SUNCLY_HOME=

# Evidence store. When DATABASE_URL is set, the Postgres store is used; otherwise
# the file store under SUNCLY_HOME/store. Example (placeholder, not a real server):
# postgresql://suncly:change-me@localhost:5432/suncly
DATABASE_URL=

# Folder that receives one report folder per attestation. Default: ./suncly-reports
SUNCLY_REPORTS_DIR=

# Defaults for `suncly attest`; both are shown before anything runs.
# Repetitions per test case (default 5) and budget in attempts (default 2 x planned runs).
SUNCLY_RUNS=
SUNCLY_BUDGET_LIMIT=

# Runner limits: per-run timeout in seconds (default 30), latency limit written into
# drafted criteria in milliseconds (default 10000), retries per run (default 2),
# concurrent runs (default 4), seconds between GetTask polls (default 0.5).
SUNCLY_RUN_TIMEOUT_S=
SUNCLY_LATENCY_LIMIT_MS=
SUNCLY_MAX_RETRIES=
SUNCLY_CONCURRENCY=
SUNCLY_POLL_INTERVAL_S=

# Card fetching: timeout in seconds (default 10) and size limit in bytes (default 1000000).
SUNCLY_CARD_TIMEOUT_S=
SUNCLY_CARD_MAX_BYTES=

# Drafting: test cases per skill, one per declared example up to this cap (default 3).
SUNCLY_MAX_TEST_CASES_PER_SKILL=

# Judge Layer 2 (docs/STAGE_4_BRIEF.md). All three are set together or not at all; without
# them Layer 2 does not run and every run with a model check is inconclusive. The model id
# has no default (DR-004); the rubric version must be the one this build carries ("1").
# Timeout per model question in seconds (default 60).
SUNCLY_JUDGE_MODEL=
SUNCLY_JUDGE_ENDPOINT=
SUNCLY_JUDGE_RUBRIC_VERSION=
SUNCLY_JUDGE_TIMEOUT_S=

# Credential for the agent under test. Read ONLY by the Runner process (DR-003).
# The full value of the HTTP Authorization header, for example "Bearer <token>".
# Placeholder only; never put a real token in a committed file.
SUNCLY_AGENT_AUTHORIZATION=

# The customer's model key for Layer 2. Read ONLY by the judge subprocess, which gets an
# environment built from scratch with this one variable (OQ-A1, decided 2026-10-07).
# Placeholder only; never put a real key in a committed file.
SUNCLY_JUDGE_MODEL_KEY=
